# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Logs
# (scan.log and journal/bybit_run.log went 2026-10-14, REFINE200 #57: their
# only writers -- scan_scheduled.bat and the Bybit executor -- are deleted.)

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code internal (agent worktrees, session state)
.claude/worktrees/

# Last-good per-ticker frame cache (restored across CI runs via actions/cache)
.cache/

# Per-run marker: which markets deliberately published nothing because their
# download came back fully blocked (scanner/config.py SCAN_SKIP_MARKER). Read
# by scan.yml within the same run and meaningless outside it — committing it
# would let one run's outage silence the next run's gate.
.scan-skipped

# Claude cloud-session push credential and per-machine Claude Code settings
# (local only, never commit). The patterns are broad on purpose (REFINE200
# #57): a credential saved under a new name must not need a .gitignore edit
# before it is safe.
.claude/gh_token.txt
.claude/settings.local.json
.claude/*token*
*.token
test/e2e/__shots__/
# #98 screenshot-diff: baselines are self-captured per environment (CI cache),
# never committed — cross-env font rendering would otherwise false-fail.
test/e2e/__baseline__/
test/e2e/__diff__/

# local dev installs (CI installs its own)
node_modules/
package-lock.json
package.json
