# /etc/vivek5/jobs.env -- environment for EVERY vivek5-* JOB unit, update.sh
# and gc.sh (deploy/DESIGN.md 3.8). Installed 0640 root:vivek5 by install.sh
# ONLY IF ABSENT; edit the installed copy, never this template.
#
# Rules:
#   * every CHANGE_ME must be replaced or blanked -- preflight.sh refuses to
#     let cutover run while one remains;
#   * systemd EnvironmentFile syntax: KEY=value, double quotes allowed, no
#     `export`, `#` comments. systemd does NOT shell-expand values, and no
#     script in the kit ever sources this file with bash (`. jobs.env` would
#     expand a `$` or run a backtick in a password) -- preflight reads single
#     keys with sed and runs its checks through systemd-run with this file;
#   * NO GH_ADMIN_TOKEN here, ever -- cutover.sh reads that from the calling
#     shell only and refuses to run if the string appears in this file;
#   * the API adapter does NOT read this file (api.env is its own, smaller).

# ---- paths (fixed by install.sh's layout; change only with the layout) -----
# The working checkout: jobs run here and write here. Never commits.
VIVEK_HOME=/opt/vivek5/app
# The publish clone (--filter=blob:none, ssh remote): the ONLY place git
# commits and pushes happen (DESIGN D6).
VIVEK_PUBLISH=/opt/vivek5/publish
# spool/ locks/ summaries/ home/ cache/ kv.json runs.json publish_head HALT
VIVEK_STATE_DIR=/opt/vivek5/state
# The python3.12 venv the runner and every job step execute from.
VIVEK_VENV=/opt/vivek5/venv
# 1 = the publish step commits+pushes data to main exactly as Actions did
# (DESIGN D2). 0 = run everything but never push (preflight --measure uses
# it for the dry scan).
VIVEK_GIT_PUBLISH=1
# The runs ledger (DESIGN 3.6). Setting it switches scanner/watchdog.py into
# LEDGER mode (a failed job row is a finding; GitHub run history is not read).
VIVEK_RUNS_LEDGER=/opt/vivek5/state/runs.json

# ---- git identity the VPS publishes under ----------------------------------
# The NAME is what tells a VPS commit apart from the owner's own pushes in
# the second-writer check (publish + update.sh). install.sh writes it
# HOST-SCOPED (vivek5-vps@<hostname>) so a second box installed from this
# template reads as a foreign writer instead of passing silently. The EMAIL must already be in
# scripts/commit_sentinel.py ALLOWED_EMAILS, which is why the default is the
# owner's GitHub noreply address (config.VPS_GIT_AUTHOR_EMAIL_DEFAULT) rather
# than a new one. Keep author and committer identical.
GIT_AUTHOR_NAME=vivek5-vps
GIT_AUTHOR_EMAIL=294004674+FakeCurrency@users.noreply.github.com
GIT_COMMITTER_NAME=vivek5-vps
GIT_COMMITTER_EMAIL=294004674+FakeCurrency@users.noreply.github.com
# The push credential is an ed25519 DEPLOY KEY generated by install.sh, never
# a token in a URL (git prints URLs on failure; the ledger keeps last lines).
# known_hosts is pre-seeded by install.sh and checked against GitHub's
# published fingerprints; StrictHostKeyChecking=yes then means a changed host
# key fails the push instead of being accepted. BatchMode + ConnectTimeout +
# ServerAlive*: a fetch/push over a stalled connection fails in about a minute
# instead of hanging while the job holds the book and publish locks (the git
# calls in the publish step have no timeout of their own; systemd's
# TimeoutStartSec would otherwise be the only thing that ends them).
GIT_SSH_COMMAND="ssh -i /etc/vivek5/deploy_key -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/vivek5/known_hosts -o StrictHostKeyChecking=yes -o BatchMode=yes -o ConnectTimeout=30 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"

# ---- a home the hardened units can write -----------------------------------
# ProtectHome=yes hides /home and /root; yfinance needs a writable cache dir
# and ssh/git look for a home. Both live under state/ (install.sh creates
# them).
HOME=/opt/vivek5/state/home
XDG_CACHE_HOME=/opt/vivek5/state/cache
# Appears in every watchdog message and step summary ("host: vps").
WATCHDOG_HOST=vps

# ---- optional off-box backup ----------------------------------------------
# rsync/scp target for a second copy of backups/ (the Actions 90-day run
# artifact had no VPS analogue). Empty = in-tree commit only. If SET, the
# backup job FAILS when the copy fails, so a dead target is loud.
# A REMOTE target, user@host:/path: the job units run ProtectSystem=strict, so
# a local path outside /opt/vivek5/{app,publish,state} is READ-ONLY to them
# (and a second copy on the same disk is not off-box anyway). rsync's ssh runs
# as vivek5 with HOME=/opt/vivek5/state/home and no TTY: seed that home's
# .ssh/known_hosts and key before setting this, or the copy fails every run.
VIVEK_BACKUP_TARGET=

# ---- alert channels (DESIGN D8: at least ONE must round-trip before cutover)
# Telegram bot token + chat id. Set BOTH, or blank BOTH to disable Telegram.
# Turns Telegram sending on for this box only (scanner/config.py reads it;
# GitHub Actions never sets it, so its behaviour is unchanged). Set to 1
# once the two Telegram lines below hold your bot's values.
VIVEK_TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
# SMTP for the email leg (CRITICAL tier). Blank = email disabled.
GBS_SMTP_HOST=
GBS_SMTP_PORT=
GBS_SMTP_USER=
GBS_SMTP_PASS=
GBS_ALERT_TO=
# Optional From: address (only test_alerts.yml exported it on Actions).
GBS_ALERT_FROM=

# ---- the morning plays digest (its OWN webhook, see CLAUDE.md MORNING PLAYS)
# Copy the value of the GitHub Actions secret of the same name. Blank = every
# morning_plays run is a green no-op that says so.
DISCORD_MORNING_WEBHOOK_URL=CHANGE_ME

# ---- broker keys: PAPER ONLY today ------------------------------------------
# Read by the kill switch's flatten path only. Blank = alert + log, no
# broker call (the documented state). Setting them ARMS an account-wide
# flatten on a paper-book breach -- read CLAUDE.md VIVEK_KILL_SWITCH_BROKERS
# before you do.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
