# /etc/vivek5/api.env -- environment for vivek5-api.service ONLY
# (deploy/DESIGN.md 3.8). Installed 0640 root:vivek5-api by install.sh if
# absent, with DISPATCH_TOKEN generated (openssl rand -hex 32).
#
# This is the only process on the box that faces the internet, so it holds
# NO broker, SMTP, Telegram, Discord or git credential -- those names must
# never appear here (tests/test_vps_deploy.py pins it). Everything the Pages
# Functions read on Cloudflare that still applies is listed.

# Loopback port Caddy proxies to (the adapter binds 127.0.0.1 only).
PORT=8787
# Static tree the ASSETS shim serves (health/heartbeat read /data/* from it).
VIVEK_PUBLIC_DIR=/opt/vivek5/app/public
# runs.json + HALT for /api/vps; spool/ for /api/dispatch (write) -- the
# adapter may write ONLY state/spool and state/kv.json (POSIX modes).
VIVEK_STATE_DIR=/opt/vivek5/state
# The combined paper book: /api/dispatch refuses a close whose symbol/market
# is not OPEN here or whose price is outside the mark band.
VIVEK_BOOK=/opt/vivek5/app/journal/vivek_bot_book.json
# Where the Functions send a "workflow dispatch" instead of GitHub (D4):
# Phase 1 = the Cloudflare Functions POST to https://<domain>/api/dispatch;
# Phase 2 = the adapter posts to itself over loopback.
DISPATCH_URL=http://127.0.0.1:8787/api/dispatch
# Bearer token for /api/dispatch (>= 32 random bytes; install.sh generates
# it). The same value goes into Cloudflare Pages as DISPATCH_TOKEN at
# cutover step 2. No token -> the endpoint answers 503, wrong -> 401.
DISPATCH_TOKEN=CHANGE_ME
# Arms /api/morning_plays (?key= / Bearer). Blank = that endpoint answers 503;
# the VPS delivers the digest from its own timers, so it is optional here.
MORNING_PLAYS_TRIGGER_SECRET=
# 1 = take the client IP from the LAST X-Forwarded-For hop, and only when the
# TCP peer is loopback (Caddy). 0 = socket address.
TRUST_PROXY=1
# 1 = serve only /api/dispatch and /api/vps (Cloudflare still fronts the
# site); 2 = serve every Function (Caddyfile.phase2 in front).
VIVEK_PHASE=1
# Optional: EODHD history key for /api/price (the Yahoo escape hatch already
# wired in _prices.js). Blank = Yahoo only.
EODHD_API_TOKEN=
# Optional: cap on /api/price deep-history years (unset = no cap).
CHART_MAX_YEARS=
