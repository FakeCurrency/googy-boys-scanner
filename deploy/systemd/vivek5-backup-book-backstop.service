# Vivek 5.0 VPS kit -- deploy/DESIGN.md section 4.  COPIED into
# /etc/systemd/system by deploy/bin/install.sh (never symlinked).  Edit the
# copy in the checkout and re-run `install.sh --units`.

[Unit]
Description=Vivek 5.0 backup scheduler-drop backstop (backup_book.yml 23:35)
Documentation=file:///opt/vivek5/app/deploy/DESIGN.md
After=network-online.target
Wants=network-online.target
# A failed run is a FINDING, never silence: the hook runs
# `python -m scanner.vps notify-failure <this unit>` (DESIGN D8).
OnFailure=vivek5-failed@%n.service

[Service]
Type=oneshot
User=vivek5
WorkingDirectory=/opt/vivek5/app
# NO leading '-': a missing env file must fail the unit, not run the
# kill switch with no alert secrets (kill_switch.yml's 2026-07-28 lesson).
EnvironmentFile=/etc/vivek5/jobs.env
# The box's own zone is left alone (other services on it depend on it,
# M6 C1); the engine's two naive local-date calls get UTC from here.
Environment=TZ=UTC
ExecStart=/opt/vivek5/app/deploy/bin/job.sh backup_book.yml slot=backstop
# 10 min = the workflow's timeout-minutes, PLUS the 'default' lock
# family's wait budget (10 min, config.VPS_LOCK_WAIT_S), PLUS a
# 15-min margin (config.VPS_UNIT_TIMEOUT_MARGIN_MIN) for what the runner's
# own budget does not cover: the fire-time gate (momentum's bounded fetch)
# and the publish step. The RUNNER's timeout is the hang detector (it
# fails the step, writes the ledger row and releases its locks); this
# is the outer backstop, so it must never fire first.
TimeoutStartSec=35min
KillMode=mixed
# journald must not drop lines from a 2,000-ticker burst.
LogRateLimitIntervalSec=0
# Hardening (DESIGN section 4): the job may write only its three trees.
ProtectSystem=strict
ReadWritePaths=/opt/vivek5/app /opt/vivek5/publish /opt/vivek5/state
ProtectProc=invisible
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
