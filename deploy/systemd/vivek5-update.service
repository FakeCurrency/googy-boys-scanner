# Vivek 5.0 VPS kit -- deploy/DESIGN.md section 4.  COPIED into
# /etc/systemd/system by deploy/bin/install.sh (never symlinked).  Edit the
# copy in the checkout and re-run `install.sh --units`.
[Unit]
Description=Vivek 5.0 code updater: fast-forward the working checkout to origin/main (DESIGN 3.7)
Documentation=file:///opt/vivek5/app/deploy/DESIGN.md
After=network-online.target
Wants=network-online.target
OnFailure=vivek5-failed@%n.service

[Service]
Type=oneshot
User=vivek5
WorkingDirectory=/opt/vivek5/app
EnvironmentFile=/etc/vivek5/jobs.env
# The box's own zone is left alone (other services on it depend on it,
# M6 C1); the engine's two naive local-date calls get UTC from here.
Environment=TZ=UTC
ExecStart=/opt/vivek5/app/deploy/bin/update.sh
TimeoutStartSec=30min
KillMode=mixed
LogRateLimitIntervalSec=0
# The full job hardening set, NoNewPrivileges=yes included: the API restart
# after a functions/ or deploy/api/ change is a REQUEST (update.sh writes
# state/api-restart; the root vivek5-api-restart.path acts on it), not a
# sudo call -- sudo is setuid and NoNewPrivileges forbids it, which is the
# point. The one extra writable tree is the venv: update.sh re-installs it
# when requirements.txt changes, and no other unit may write it.
ProtectSystem=strict
ReadWritePaths=/opt/vivek5/app /opt/vivek5/publish /opt/vivek5/state
ReadWritePaths=/opt/vivek5/venv
ProtectProc=invisible
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
