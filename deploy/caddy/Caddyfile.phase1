# Vivek 5.0 -- Caddyfile PHASE 1 (deploy/DESIGN.md 6, D7).
#
# Cloudflare Pages still serves the site and runs the Functions; the ONLY
# thing this box exposes is the typed dispatch endpoint the Functions call
# (DISPATCH_URL) and the read-only ledger view. Everything else is 404 here,
# so the Node adapter's wider surface (price/quote relays, the healer) stays
# unreachable until Phase 2 opens it on purpose.
#
# A HOSTNAME IS REQUIRED: Workers' fetch validates public CAs, so the
# Functions cannot call an IP or a self-signed cert, and plain http would
# carry the bearer token in clear. Set VIVEK_DOMAIN in /etc/vivek5/caddy.env
# (install.sh writes the template; vivek5-caddy.service loads it) and point an
# A/AAAA record at this box; Caddy obtains the certificate itself. :80/:443
# already taken by something else on the box? preflight says so and offers
# the alternatives (its own server, or a Cloudflare Tunnel).
#
# Installed by install.sh as /etc/vivek5/Caddyfile (--phase 1), served by OUR
# pinned Caddy (/opt/vivek5/caddy/caddy, vivek5-caddy.service) -- never the
# distro caddy or caddy.service. Validate with
#   /opt/vivek5/caddy/caddy validate --adapter caddyfile --config /etc/vivek5/Caddyfile --envfile /etc/vivek5/caddy.env
# Requires Caddy >= 2.8 (install.sh pins a release; never Ubuntu's 2.6.2 -- D9).

{
	# Caddy's admin API on a unix socket inside OUR 0700 data dir, never the
	# default localhost:2019 (M6 C4, 2026-09-27 host review): 2019 is where a
	# distro/other Caddy on this box already listens -- ours would then fail
	# to start -- and a TCP admin port lets ANY local process (a job, the
	# trading bots) rewrite the routes or read the basic-auth hash.
	# `caddy reload` (ExecReload) finds the socket in this same config.
	admin unix//opt/vivek5/caddy/data/admin.sock
}

{$VIVEK_DOMAIN} {
	# Optional second factor: only Cloudflare's egress may reach the dispatch
	# route (the Functions call from Cloudflare IPs). Left OFF because the
	# ranges change and a stale list turns every SCAN click into a silent 403
	# with nothing on the box saying why; if you enable it, fetch the current
	# lists from https://www.cloudflare.com/ips-v4 and /ips-v6 and re-check
	# them when a dispatch stops arriving.
	# @notcf not remote_ip 173.245.48.0/20 103.21.244.0/22 ...
	# handle @notcf {
	# 	respond 403
	# }

	@vps path /api/dispatch /api/vps
	handle @vps {
		# The adapter refuses a dispatch body over 16 KiB anyway; cap it here
		# too so a flood never reaches Node's memory (security review).
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:8787 {
			# Unambiguous client address regardless of Caddy version: the
			# adapter trusts only the LAST hop, and only from loopback.
			header_up X-Forwarded-For {http.request.remote.host}
		}
	}

	handle {
		respond 404
	}

	log {
		output stderr
		format filter {
			# Never let a ?key= secret land in a log line (security review).
			request>uri query {
				delete key
			}
		}
	}
}
