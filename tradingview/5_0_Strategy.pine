//@version=6
// =============================================================================
// 5_0_Strategy  --  the price pane of the 5.0 "Strategy" chart  (v1, 2026-10-17)
// -----------------------------------------------------------------------------
// Rebuilt from one screenshot of the author's "5_0_Strategy" on FXCM:SPX500,
// 15 minutes, Fri 9 Oct 16:45 to Fri 16 Oct 22:45 2026 (chart time, UTC+3).
// The screenshot was digitised bar by bar (about 480 candles, the three lines
// and the header values) and each rule below was fitted against it. Measured,
// not guessed:
//
//   * Fast / Mid / Slow = SMA 12 / 26 / 200 of close. The header's three values
//     (7658.20 / 7693.51 / 7719.41) match to within 1 point (+0.16 / -0.52 /
//     -0.83). EMAs and the 20/50/200 or 9/21/200 sets miss by 12-30 points.
//   * Slow line: green while the 200 SMA is rising, red while it is falling
//     (263 of 265 measurable bars).
//   * Fast and Mid lines share one colour: green when Fast > Mid and the 200 is
//     rising, red when Fast < Mid and the 200 is falling, blue otherwise
//     (192 of 193 readable bars). The Fast line is drawn fainter.
//   * Grey band between the Fast and the Slow line, one colour throughout.
//   * Candles: green when the body sits above Fast and Mid and the close is
//     above the 200, red for the mirror, blue otherwise (about 96% of clean bars;
//     every miss is within 2 points of a line).
//   * "Bullish +200" / "-200 Bearish" are TradingView STRATEGY order markers:
//     "Bullish" / "Bearish" is the order name and 200 the order size. Most
//     simply an always-in-the-market strategy of 100 units reversing (close
//     100, open 100); a long-only strategy of 200 units whose exit is named
//     "Bearish" draws exactly the same markers, and one screenshot cannot tell
//     them apart. This script draws the reversal reading. The author's daily
//     charts showed "+2" / "-2": the same marker at 1 unit (2 if long-only).
//     The vertical column is the bar the setup fired on; the order fills at the
//     next bar's open, which is where the marker sits. A setup in the direction
//     already held prints a column but no marker (pyramiding 0). This script
//     is an indicator, so it replays that position logic itself and draws the
//     markers as labels.
//   * Every setup in the screenshot is a counter-trend fade: bearish setups
//     fire above the 200 with Fast > Mid, bullish ones below it with Fast < Mid
//     (7 of 7). That gate is `Counter-trend side only`.
//
// NOT recoverable from one screenshot: the trigger that decides WHICH bar inside
// that context is a setup. More than a million rule variants (RSI, Stochastic,
// CCI, Williams %R, MACD, divergences, pivots, Bollinger / Keltner, MA crosses,
// stretch, candle patterns and their pairs) were scored against the six setup
// bars and none reproduces them. `Setup trigger` is therefore a stand-in, and
// the markers this script prints will NOT land on the same bars as the
// author's. Band re-entry (close back inside Bollinger 20 / 2.5) was the closest
// family and fires about as often (6 markers on the screenshot week against 5).
//
// Chart template only: nothing in the scanner reads this file. See
// tradingview/README.md for how it was measured and how to install it.
// =============================================================================
indicator("Vivek 5.0 Strategy", shorttitle = "Vivek 5.0 Strategy", overlay = true, max_labels_count = 500)

// ---------------------------------------------------------------- inputs ----
// Inputs stay out of the status line so the header reads like the original:
// the name and three prices.
gMA = "Moving averages"
fastLen  = input.int(12,  "Fast Length", minval = 1, group = gMA, display = display.none)
midLen   = input.int(26,  "Mid Length",  minval = 1, group = gMA, display = display.none)
slowLen  = input.int(200, "Slow Length", minval = 1, group = gMA, display = display.none)
maSrc    = input.source(close, "Source", group = gMA, display = display.none)
slopeLen = input.int(1, "Slow slope over (bars)", minval = 1, group = gMA, display = display.none)

gSty = "Style"
cBull     = input.color(#1f9d3a, "Bull",    group = gSty, inline = "c")
cNeutral  = input.color(#2f54eb, "Neutral", group = gSty, inline = "c")
cBear     = input.color(#e3172a, "Bear",    group = gSty, inline = "c")
fastTr    = input.int(55, "Fast line transparency", minval = 0, maxval = 100, group = gSty, display = display.none)
midTr     = input.int(25, "Mid line transparency",  minval = 0, maxval = 100, group = gSty, display = display.none)
slowWidth = input.int(4, "Slow line width", minval = 1, maxval = 10, group = gSty, display = display.none)
cBand     = input.color(color.new(color.gray, 80), "Fast-Slow band", group = gSty)
paintBars = input.bool(true, "Colour the candles", group = gSty, display = display.none)

gSig = "Signals"
showSig  = input.bool(true, "Bullish / Bearish markers", group = gSig, display = display.none)
showCols = input.bool(true, "Column on setup bars", group = gSig, display = display.none)
trigger  = input.string("Band re-entry", "Setup trigger", options = ["Band re-entry", "RSI exhaustion", "Off"], group = gSig, display = display.none,
     tooltip = "Stand-in: the author's own trigger could not be recovered from the screenshot. Band re-entry = the close comes back inside the Bollinger band. RSI exhaustion = RSI comes back out of overbought / oversold.")
useCtx   = input.bool(true, "Counter-trend side only (bearish above the Slow with Fast > Mid, bullish mirrored)", group = gSig, display = display.none)
bbLen    = input.int(20, "Band length", minval = 2, group = gSig, inline = "bb", display = display.none)
bbMult   = input.float(2.5, "width (std devs)", minval = 0.1, step = 0.1, group = gSig, inline = "bb", display = display.none)
rsiLen   = input.int(14, "RSI length", minval = 1, group = gSig, inline = "rsi", display = display.none)
rsiOB    = input.float(70, "OB", group = gSig, inline = "rsi", display = display.none)
rsiOS    = input.float(30, "OS", group = gSig, inline = "rsi", display = display.none)
qty      = input.int(100, "Position size shown on the markers", minval = 1, group = gSig, display = display.none,
     tooltip = "Read as a strategy holding 100 units and reversing, so each reversal shows 200 (a 200-unit long-only strategy with an exit named Bearish draws the same markers; the screenshot cannot separate them). The first marker on the chart shows the size alone.")
colTr    = input.int(80, "Column transparency", minval = 0, maxval = 100, group = gSig, display = display.none)
cColBear = input.color(#22c55e, "Bearish setup column", group = gSig, inline = "col")
cColBull = input.color(#ef4444, "Bullish setup column", group = gSig, inline = "col")
cArrBull = input.color(#3d63c9, "Bullish marker", group = gSig, inline = "mk")
cArrBear = input.color(#d0405f, "Bearish marker", group = gSig, inline = "mk")
cMkText  = input.color(#6b6b6b, "Marker text",    group = gSig, inline = "mk")

// ----------------------------------------------------------------- lines ----
fast   = ta.sma(maSrc, fastLen)
mid    = ta.sma(maSrc, midLen)
slow   = ta.sma(maSrc, slowLen)
slowUp = slow > slow[slopeLen]

lineCol = fast > mid and slowUp ? cBull : fast < mid and not slowUp ? cBear : cNeutral

pFast = plot(fast, "Fast", color = color.new(lineCol, fastTr), linewidth = 1)
pMid  = plot(mid,  "Mid",  color = color.new(lineCol, midTr),  linewidth = 1)
pSlow = plot(slow, "Slow", color = slowUp ? cBull : cBear,     linewidth = slowWidth)
fill(pFast, pSlow, color = cBand, title = "Fast-Slow band")

// --------------------------------------------------------------- candles ----
bodyLo     = math.min(open, close)
bodyHi     = math.max(open, close)
candleBull = bodyLo > fast and bodyLo > mid and close > slow
candleBear = bodyHi < fast and bodyHi < mid and close < slow
barcolor(paintBars ? (candleBull ? cBull : candleBear ? cBear : cNeutral) : na, title = "Candle colour")

// ---------------------------------------------------------------- setups ----
// Every trigger is evaluated on every bar (a ta.* call inside a conditional
// branch keeps a broken history), then the input picks one.
basis    = ta.sma(close, bbLen)
dev      = bbMult * ta.stdev(close, bbLen)
rsiV     = ta.rsi(close, rsiLen)
// a zero-width band (20 identical closes) has no outside to come back from;
// keep each ta.* call as the LEFT operand: v6 `and` is lazy
bandBear = ta.crossunder(close, basis + dev) and dev[1] > 0
bandBull = ta.crossover(close, basis - dev) and dev[1] > 0
rsiBear  = ta.crossunder(rsiV, rsiOB)
rsiBull  = ta.crossover(rsiV, rsiOS)

trigBear = trigger == "Band re-entry" ? bandBear : trigger == "RSI exhaustion" ? rsiBear : false
trigBull = trigger == "Band re-entry" ? bandBull : trigger == "RSI exhaustion" ? rsiBull : false

ctxBear   = close > slow and fast > mid
ctxBull   = close < slow and fast < mid
setupBear = trigBear and (not useCtx or ctxBear)
setupBull = trigBull and (not useCtx or ctxBull) and not setupBear

// ------------------------------------------------------- position replay ----
// The original is a strategy: a setup's order fills at the next bar's open and
// is skipped when that side is already held. `pos` replays it: +1 long,
// -1 short, 0 before the first order. setupBull[1] / setupBear[1] are the
// previous bar's closed values, so a marker never moves once drawn.
var int pos = 0
prevPos  = pos
fillBull = setupBull[1] and pos != 1
fillBear = not fillBull and setupBear[1] and pos != -1
if fillBull
    pos := 1
else if fillBear
    pos := -1

// a reversal closes the old position and opens the new one: twice the size
fillQty = prevPos == 0 ? qty : 2 * qty
if showSig and fillBull
    label.new(bar_index, low, "Bullish\n+" + str.tostring(fillQty), yloc = yloc.belowbar, color = cArrBull,
         style = label.style_arrowup, textcolor = cMkText, size = size.small)
if showSig and fillBear
    label.new(bar_index, high, "-" + str.tostring(fillQty) + "\nBearish", yloc = yloc.abovebar, color = cArrBear,
         style = label.style_arrowdown, textcolor = cMkText, size = size.small)

// a column on the setup bar, once the bar has closed (no intrabar flicker)
setupCol = setupBear ? color.new(cColBear, colTr) : setupBull ? color.new(cColBull, colTr) : na
bgcolor(showCols and barstate.isconfirmed ? setupCol : na, title = "Setup columns")

// ---------------------------------------------------------------- alerts ----
// Fire on the setup bar's close when it will flip the position: the entry is
// the next bar's open, where the marker appears. Choose "Once Per Bar Close".
alertcondition(setupBull and pos != 1 and barstate.isconfirmed, title = "Bullish",
     message = "Vivek 5.0 Strategy: Bullish on {{ticker}} {{interval}}, close {{close}}. Entry at the next open.")
alertcondition(setupBear and pos != -1 and barstate.isconfirmed, title = "Bearish",
     message = "Vivek 5.0 Strategy: Bearish on {{ticker}} {{interval}}, close {{close}}. Entry at the next open.")
